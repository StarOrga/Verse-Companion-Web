{
  "name": "Verse Companion",
  "short_name": "Companion",
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "description": "Verse Companion – unofficial fan tool for Star Citizen: news, codex, hangar and loadouts. Not affiliated with the Cloud Imperium group of companies.",
  "categories": [
    "utilities",
    "games",
    "news"
  ],
  "theme_color": "#0a0e1a",
  "background_color": "#050810",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "scope": "./",
  "start_url": "./",
  "shortcuts": [
    {
      "name": "Holdings",
      "url": "hq#bestand",
      "icons": [
        {
          "src": "icons/brand/vc-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Now",
      "url": "hq#jetzt",
      "icons": [
        {
          "src": "icons/brand/vc-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icons/brand/vc-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icons/brand/vc-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/brand/vc-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/brand/vc-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/brand/vc-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "icons/shots/narrow-verse.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Verse: patch news and the star map"
    },
    {
      "src": "icons/shots/wide-verse.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Verse: patch news and the star map"
    }
  ]
}
